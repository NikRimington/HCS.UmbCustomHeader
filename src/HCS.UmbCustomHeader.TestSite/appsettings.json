{
  "$schema": "appsettings-schema.json",
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=(localdb)\\MSSQLLocalDB;Database=GroupedNavTest;Integrated Security=true;TrustServerCertificate=true",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "HCS": {
    "UmbCustomHeader": {
      "Enabled": true,
      "Groups": [
        {
          "Alias": "management",
          "Label": "Management",
          "Icon": "icon-settings",
          "Sections": [
            "Umb.Section.Settings",
            "Umb.Section.Users",
            "Umb.Section.Members"
          ]
        },
        {
          "Alias": "addons",
          "Label": "Umbraco Addons",
          "Icon": "icon-box",
          "Sections": [
            "Umb.Section.Forms",
            "commerce",
            "Umb.Section.Workflow"
          ]
        }
      ]
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "2762818a-3c75-435c-84e0-5d272d8e7fb3",
        "SanitizeTinyMce": true
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "1234567890"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "VwjWp8GyLF3uu4q8cfHRqZj5f1ckB05W3YqAWSpp6+stN6o5hT/0H30BAKZeu7vxMOanctkickhZHCumWe924A=="
      }
    }
  }
}
